								</Path>
								<xsl:choose>
									<xsl:when test="starts-with($ParentNode, 'C_')">
										<xsl:variable name="ParentPosition" select="count(../preceding-sibling::*) + 1"/>
										<ParentNode tagname="{$ParentNode}" position="{$vCompositPosition}" segmentPosition="{$Position}"/>
										<xsl:for-each select="$D_Element">
