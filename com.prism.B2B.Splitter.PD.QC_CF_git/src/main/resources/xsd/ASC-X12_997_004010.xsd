									</xsl:otherwise>
								</xsl:choose>
								<xsl:variable name="i" select="count(preceding-sibling::*[name()=name(current())])"/>
								<xsl:choose>
									<xsl:when test="$i">
										<xsl:value-of select="concat('[', $i + 1, ']')"/>
									</xsl:when>
									<xsl:otherwise>
										<xsl:variable name="j" select="count(following-sibling::*[name()=name(current())])"/>
										<xsl:if test="$j">
											<xsl:value-of select="concat('[',1, ']')"/>
										</xsl:if>
									</xsl:otherwise>
								</xsl:choose>
								<xsl:if test="position()!=last()">
									<xsl:text>/</xsl:text>
								</xsl:if>
							</xsl:for-each>
